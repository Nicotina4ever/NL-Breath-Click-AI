// SPDX-License-Identifier: MPL-2.0
// ============================================================================
//  breathclick.rc - Risorsa icona
//
//  L'icona dell'applicazione. Il primo ID deve restare 1: e' il valore che
//  Windows usa come icona predefinita dell'eseguibile, e l'editor lo carica
//  esplicitamente per la barra delle applicazioni e per il titolo.
// ============================================================================

#include <windows.h>

1 ICON "breathclick.ico"

#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION BC_FILE_VERSION
 PRODUCTVERSION BC_FILE_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "BreathClick"
            VALUE "FileDescription", "BreathClick Studio release candidate"
            VALUE "FileVersion", BC_STUDIO_VERSION
            VALUE "InternalName", "bc_studio"
            VALUE "OriginalFilename", "bc_studio.exe"
            VALUE "ProductName", "BreathClick Studio"
            VALUE "ProductVersion", BC_STUDIO_VERSION
            VALUE "LegalCopyright", "Copyright (c) 2026 BreathClick"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
